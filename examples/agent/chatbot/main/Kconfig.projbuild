menu "Example Configuration"
    menuconfig EXAMPLE_AGENTS_ENABLE_COZE
        bool "Enable Coze agent"
        select BROOKESIA_AGENT_COZE_ENABLE_AUTO_REGISTER
        default n

    if EXAMPLE_AGENTS_ENABLE_COZE
        config EXAMPLE_AGENTS_COZE_APP_ID
            string "App ID"
            default "110049xxxxxxx"

        config EXAMPLE_AGENTS_COZE_PUBLIC_KEY
            string "Public key"
            default "lsKjtB67xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

        config EXAMPLE_AGENTS_COZE_PRIVATE_KEY_FILE_PATH
            string "Private key"
            default "./private_key.pem"

        config EXAMPLE_AGENTS_COZE_CUSTOM_CONSUMER
            string "Custom consumer (Optional)"
            default ""

        menuconfig EXAMPLE_AGENTS_COZE_BOT1_ENABLE
            bool "Bot 1"
            default y

        if EXAMPLE_AGENTS_COZE_BOT1_ENABLE
            config EXAMPLE_AGENTS_COZE_BOT1_NAME
                string "Bot name"
                default "Lin Jia Nv Hai"

            config EXAMPLE_AGENTS_COZE_BOT1_ID
                string "Bot ID"
                default "7516538xxxxxxxxxxxx"

            config EXAMPLE_AGENTS_COZE_BOT1_DESCRIPTION
                string "Bot description"
                default "A warm-voiced female AI character who listens to the user's thoughts and offers comforting responses."

            config EXAMPLE_AGENTS_COZE_BOT1_VOICE_ID
                string "Bot voice ID"
                default "7426720361733144585"
        endif

        menuconfig EXAMPLE_AGENTS_COZE_BOT2_ENABLE
            bool "Bot 2"
            default n

        if EXAMPLE_AGENTS_COZE_BOT2_ENABLE
            config EXAMPLE_AGENTS_COZE_BOT2_NAME
                string "Bot name"
                default "Wan Qu Da Shu"

            config EXAMPLE_AGENTS_COZE_BOT2_ID
                string "Bot ID"
                default "7516538xxxxxxxxxxxx"

            config EXAMPLE_AGENTS_COZE_BOT2_DESCRIPTION
                string "Bot description"
                default "A male AI character with a regional accent. He responds quickly and concisely, but does not perform actions on behalf of the user."

            config EXAMPLE_AGENTS_COZE_BOT2_VOICE_ID
                string "Bot voice ID"
                default "7426720361732915209"
        endif
    endif

    menuconfig EXAMPLE_AGENTS_ENABLE_OPENAI
        bool "Enable OpenAI agent"
        select BROOKESIA_AGENT_OPENAI_ENABLE_AUTO_REGISTER
        default n

    if EXAMPLE_AGENTS_ENABLE_OPENAI
        config EXAMPLE_AGENTS_OPENAI_API_KEY
            string "API key"
            default "sk-proj-xxx"

        config EXAMPLE_AGENTS_OPENAI_MODEL
            string "Model"
            default "gpt-realtime-2"

        config EXAMPLE_AGENTS_OPENAI_VOICE
            string "Voice"
            default "alloy"
    endif

    menuconfig EXAMPLE_AGENTS_ENABLE_XIAOZHI
        bool "Enable Xiaozhi agent"
        select BROOKESIA_AGENT_XIAOZHI_ENABLE_AUTO_REGISTER
        default y

    menuconfig EXAMPLE_AGENTS_ENABLE_CUSTOM_IA
        bool "Enable CustomIA agent"
        select BROOKESIA_AGENT_CUSTOM_IA_ENABLE_AUTO_REGISTER
        default n

    if EXAMPLE_AGENTS_ENABLE_CUSTOM_IA
        config EXAMPLE_AGENTS_CUSTOM_IA_SERVER_URL
            string "Backend server URL"
            default "http://192.168.1.100:3000"
            help
                Base URL of the CustomIA HTTP backend, as reachable from the device (LAN address of the
                machine running it). Must not have a trailing slash.
    endif

    menuconfig EXAMPLE_SD_UPDATE_ENABLE
        bool "Enable SD card update from web service"
        default n
        help
            On the first Wi-Fi connection, fetch the list of files to update from the SD update
            server ("{URL}/update", GET), compare them (by MD5) against what's already under
            /sdcard/update, and download any missing/changed file ("{URL}/update", POST) into that
            folder, creating sub-folders as needed.

    if EXAMPLE_SD_UPDATE_ENABLE
        config EXAMPLE_SD_UPDATE_SERVER_URL
            string "SD update server URL"
            default "http://192.168.1.100:4000"
            help
                Base URL of the SD update HTTP backend, as reachable from the device (LAN address of
                the machine running it). Must not have a trailing slash.
    endif

    menuconfig EXAMPLE_FW_UPDATE_ENABLE
        bool "Enable firmware OTA update from web service"
        default n
        help
            On the first Wi-Fi connection, fetch the current firmware version from the firmware
            update server ("{URL}/firmware", GET -> {"version": ..., "md5": ...}), compare it
            against the version recorded in /sdcard/VERSION (created with "0" if missing), and if
            the server's version is higher: download the firmware ("{URL}/firmware/{version}", GET)
            to the SD card verifying its MD5, copy it into the inactive ota_0/ota_1 partition
            verifying the MD5 again, switch the bootloader to that partition, and reboot.

    if EXAMPLE_FW_UPDATE_ENABLE
        config EXAMPLE_FW_UPDATE_SERVER_URL
            string "Firmware update server URL"
            default "http://192.168.1.100:4000"
            help
                Base URL of the firmware update HTTP backend, as reachable from the device (LAN
                address of the machine running it). Must not have a trailing slash.
    endif
endmenu
