    "type": "theme",
    "id": "dark",
    "assets": [
        "color/dark.json",
        "font/default.json",
        "size/default.json",
        "style/default.json"
    ],
    "variants": [
        {
            "when": "${expr(${env.widthDp} == 1024dp && ${env.heightDp} == 600dp)}",
            "assets": [
                "font/1024x600.json",
                "size/1024x600.json"
            ]
        },
        {
            "when": "${expr(${env.widthDp} == 800dp && ${env.heightDp} == 480dp)}",
