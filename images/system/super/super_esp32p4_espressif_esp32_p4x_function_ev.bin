                "font/portrait.json",
                "size/portrait.json"
            ]
        },
        {
            "when": "${expr(${env.widthDp} <= 360dp || ${env.heightDp} <= 240dp)}",
            "assets": [
                "font/small.json",
                "size/small.json"
            ]
        }
