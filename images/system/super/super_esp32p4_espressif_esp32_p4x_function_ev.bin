                        "press.scale"
                    ],
                    "commonProps": {
                        "clickable": true,
                        "scrollable": false
                    },
                    "bindings": {
                        "commonProps.hidden": "passwordToggleHidden"
                    },
                    "events": [
                        {
                            "type": "clicked",
                            "action": "super.keyboard.toggle_password"
                        }
                    ],
