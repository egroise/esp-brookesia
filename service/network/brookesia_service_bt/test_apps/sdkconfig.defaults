CONFIG_ESP_TASK_WDT_EN=n
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y

CONFIG_BROOKESIA_SERVICE_BT_ENABLE_AUTO_REGISTER=y

# Register the actual A2DP HAL interface. On targets without Classic Bluetooth
# this produces the adaptor's explicit unavailable implementation.
CONFIG_BT_ENABLED=y
CONFIG_BROOKESIA_HAL_ADAPTOR_ENABLE_BT_DEVICE=y
